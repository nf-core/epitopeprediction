// Builds a minimal stand-in for a DTU tarball, since the real ones cannot be redistributed
def fakeTarball = { String dir, String name, String topDir, String platform, String version ->
    def root = new File(dir, name)
    new File(root, "${topDir}/${platform}/bin").mkdirs()
    new File(root, "${topDir}/data").mkdirs()
    new File(root, "${topDir}/${platform}/bin/tool").text = "binary\n"
    new File(root, "${topDir}/${topDir.tokenize('-')[0]}").text = "#! /bin/tcsh -f\nsetenv\tNMHOME\t/tools/src/${topDir}\n"
    new File(root, "${topDir}/data/version").text = "${version}\n"
    def tarball = new File(dir, "${name}.tar.gz")
    def proc = ['tar', '-czf', tarball.path, '-C', root.path, topDir].execute()
    proc.waitFor()
    assert proc.exitValue() == 0
    return tarball.path
}

nextflow_process {

    name "Test Process UNPACK_NETMHC_SOFTWARE"
    script "../main.nf"
    process "UNPACK_NETMHC_SOFTWARE"

    tag "pipeline"
    tag "unpack_netmhc_software"

    test("netmhciipan - unknown sub-release is accepted") {

        when {
            def tarball = fakeTarball("${outputDir}", "valid", "netMHCIIpan-4.3", "Linux_x86_64", "NetMHCIIpan version 4.3z")
            process {
                """
                input[0] = ['netmhciipan', '4.3', file('${tarball}', checkIfExists: true), 'netMHCIIpan']
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.nonfree_tools[0]).resolve('netMHCIIpan').text.contains('setenv NMHOME `realpath -s $0') },
                { assert snapshot(process.out.versions_netmhc).match() }
            )
        }
    }

    test("netmhcpan - sub-release is accepted") {

        when {
            def tarball = fakeTarball("${outputDir}", "valid", "netMHCpan-4.2", "Linux_x86_64", "NetMHCpan version 4.2b")
            process {
                """
                input[0] = ['netmhcpan', '4.2', file('${tarball}', checkIfExists: true), 'netMHCpan']
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions_netmhc).match() }
            )
        }
    }

    test("netmhciipan - netMHCpan tarball is rejected") {

        when {
            def tarball = fakeTarball("${outputDir}", "wrong_tool", "netMHCpan-4.2", "Linux_x86_64", "NetMHCpan version 4.2b")
            process {
                """
                input[0] = ['netmhciipan', '4.3', file('${tarball}', checkIfExists: true), 'netMHCIIpan']
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("expected the top-level folder 'netMHCIIpan-4.3', found: netMHCpan-4.2") }
            )
        }
    }

    test("netmhciipan - older minor version is rejected") {

        when {
            def tarball = fakeTarball("${outputDir}", "wrong_minor", "netMHCIIpan-4.2", "Linux_x86_64", "NetMHCIIpan version 4.2c")
            process {
                """
                input[0] = ['netmhciipan', '4.3', file('${tarball}', checkIfExists: true), 'netMHCIIpan']
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("expected the top-level folder 'netMHCIIpan-4.3', found: netMHCIIpan-4.2") }
            )
        }
    }

    test("netmhciipan - mismatching data/version is rejected") {

        when {
            def tarball = fakeTarball("${outputDir}", "wrong_version", "netMHCIIpan-4.3", "Linux_x86_64", "NetMHCIIpan version 4.2c")
            process {
                """
                input[0] = ['netmhciipan', '4.3', file('${tarball}', checkIfExists: true), 'netMHCIIpan']
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("data/version reports '4.2c', expected 4.3") }
            )
        }
    }

    test("netmhciipan - Darwin tarball is rejected") {

        when {
            def tarball = fakeTarball("${outputDir}", "darwin", "netMHCIIpan-4.3", "Darwin_x86_64", "NetMHCIIpan version 4.3i")
            process {
                """
                input[0] = ['netmhciipan', '4.3', file('${tarball}', checkIfExists: true), 'netMHCIIpan']
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("no Linux_x86_64 binaries found") }
            )
        }
    }

    test("netmhcpan - non-gzip file is rejected") {

        when {
            def html = new File("${outputDir}", "netMHCpan-4.2b.Linux.tar.gz")
            html.parentFile.mkdirs()
            html.text = "<html><body>Download expired</body></html>\n"
            process {
                """
                input[0] = ['netmhcpan', '4.2', file('${html.path}', checkIfExists: true), 'netMHCpan']
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("not a readable .tar.gz archive") }
            )
        }
    }

    test("netmhcpan - stub") {

        options "-stub"

        when {
            def tarball = fakeTarball("${outputDir}", "stub", "netMHCpan-4.2", "Linux_x86_64", "NetMHCpan version 4.2b")
            process {
                """
                input[0] = ['netmhcpan', '4.2', file('${tarball}', checkIfExists: true), 'netMHCpan']
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions_netmhc).match() }
            )
        }
    }
}

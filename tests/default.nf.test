nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "variant"
    profile "test"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def peptides = path("${params.outdir}/variant_peptides/sample1_length_9.tsv").csv(sep: '\t')
            def consequences = peptides.columns['consequence']
            assertAll(
                { assert workflow.success },
                // without --wild_type only putative neoepitopes are written
                { assert peptides.columns['peptide_origin'].every { it == 'MT' } },
                { assert consequences.contains('missense') },
                { assert consequences.contains('inframe_del') },
                { assert consequences.contains('FS') },
                { assert path("${params.outdir}/variant_fasta/sample1.annotated.fasta").text.contains('|missense|') },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_epitopeprediction_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test --proteome_reference (self-filter)") {

        when {
            params {
                outdir = "$outputDir"
                // this reference proteome is exactly the FGFR3 MT window of the fixture,
                // so every FGFR3 peptide and its wild-type row are dropped
                proteome_reference = "https://raw.githubusercontent.com/nf-core/test-datasets/epitopeprediction/testdata/proteins/proteome_ref.fasta"
                wild_type          = true
            }
        }

        then {
            def peptides = path("${params.outdir}/variant_peptides/sample1_length_9.tsv").text +
                           path("${params.outdir}/variant_peptides/sample1_length_10.tsv").text
            assertAll(
                { assert workflow.success },
                { assert !peptides.contains('FGFR3') },
                { assert peptides.contains('CEBPA') }
            )
        }
    }

    test("-profile test --wild_type --wide_format_output") {

        when {
            params {
                outdir             = "$outputDir"
                wild_type          = true
                wide_format_output = true
            }
        }

        then {
            def peptides = path("${params.outdir}/variant_peptides/sample1_length_9.tsv").csv(sep: '\t').rows
            def wt       = peptides.findAll { it.peptide_origin.contains('WT') }
            def wide     = path("${params.outdir}/predictions/sample1.tsv").csv(sep: '\t')
            def ba       = wide.columnNames.findAll { it ==~ /mhcnuggets_.*_BA/ }
            def stats    = path("${params.outdir}/multiqc/multiqc_data/multiqc_peptide_binding_prediction_stats.txt").csv(sep: '\t').rows[0]
            assertAll(
                { assert workflow.success },
                { assert wt },
                // every WT row is the aligned wild type of a mutant substitution peptide
                { assert wt.every { w -> peptides.any { w.sequence in it.wildtype.split(';') } } },
                { assert wt.every { it.consequence == 'missense' } },
                // rows with NA metadata (WT, frameshift) keep their per-allele scores in wide format
                { assert ba && wide.rows.every { row -> ba.any { row[it] != null } } },
                // MultiQC counts mutant peptides only
                { assert stats['Binders'] + stats['Non-binders'] == wide.columns['peptide_origin'].count { it.contains('MT') } },
                { assert snapshot(
                    path("${params.outdir}/variant_peptides/sample1_length_9.tsv"),
                    path("${params.outdir}/variant_peptides/sample1_length_10.tsv")
                ).match() }
            )
        }
    }

    test("-profile test --wild_type --binder_only") {

        when {
            params {
                outdir      = "$outputDir"
                // the fixture has no A*01:01 binders; C*03:04 binds mutants whose wild type does not
                def samplesheet = new File("$outputDir/samplesheet_binders.csv")
                samplesheet.parentFile.mkdirs()
                samplesheet.text = [
                    "sample,alleles,mhc_class,filename,tumor_sample",
                    "sample1,A*01:01;C*03:04,I,https://raw.githubusercontent.com/nf-core/test-datasets/epitopeprediction/testdata/variants/variants_chr4_chr19.vcf,TUMOR"
                ].join('\n') + '\n'
                input       = samplesheet.toString()
                wild_type   = true
                binder_only = true
            }
        }

        then {
            def predictions = path("${params.outdir}/predictions/sample1.tsv").csv(sep: '\t').rows
            def mt_binders  = predictions.findAll { it.peptide_origin.contains('MT') && it.binder }
            def non_binders = predictions.findAll { !it.binder }
            assertAll(
                { assert workflow.success },
                // a non-binder is only kept as the wild type of a mutant binder at the same allele
                { assert non_binders },
                { assert non_binders.every { w -> mt_binders.any { it.predictor == w.predictor && it.allele == w.allele && w.sequence in it.wildtype.split(';') } } }
            )
        }
    }

    test("-profile test Strelka-style VCF without FORMAT/GT") {

        when {
            params {
                outdir = "$outputDir"
                // the same four variants as Strelka writes them: no FORMAT/GT, NORMAL and TUMOR columns
                input  = "https://raw.githubusercontent.com/nf-core/test-datasets/epitopeprediction/testdata/sample_sheets/sample_sheet_variants_grch38_strelka.csv"
            }
        }

        then {
            def consequences = path("${params.outdir}/variant_peptides/strelka_length_9.tsv").csv(sep: '\t').columns['consequence']
            assertAll(
                { assert workflow.success },
                { assert ['missense', 'inframe_del', 'FS'].every { consequences.contains(it) } }
            )
        }
    }

    test("-profile test proximal missense variants") {

        when {
            params {
                outdir = "$outputDir"
                // FGFR3 S249C plus two synthetic missense SNVs two and three codons downstream
                input  = "https://raw.githubusercontent.com/nf-core/test-datasets/epitopeprediction/testdata/sample_sheets/sample_sheet_variants_grch38_proximal.csv"
            }
        }

        then {
            def peptides = path("${params.outdir}/variant_peptides/proximal_length_9.tsv").csv(sep: '\t').columns['sequence']
            assertAll(
                { assert workflow.success },
                // each variant alone (CPHR, SPRR, SPHQ) and all three combined (CPRQ)
                { assert ['CPHR', 'SPRR', 'SPHQ', 'CPRQ'].every { motif -> peptides.any { it.contains(motif) } } }
            )
        }
    }
}

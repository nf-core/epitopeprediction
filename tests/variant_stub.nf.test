// Self-contained STUB test for the variant (VCF) path: bcftools -> VEP -> pvacseq -> peptides.
// Runs every process' stub (no real VEP cache / tools needed), so it validates the wiring in CI
// without the ~20 GB Ensembl cache. Real end-to-end validation uses a real cache (see conf/test.config).
//
// NOTE: authored without a local nf-test binary — run `nf-test test tests/variant_stub.nf.test`
// once to confirm and, if needed, adjust the fixture path resolution for your nf-test version.
nextflow_pipeline {

    name "Test variant path (stub)"
    script "../main.nf"
    tag "pipeline"
    tag "variant"
    tag "stub"

    test("variant path -stub") {

        options "-stub"

        when {
            params {
                outdir            = "$outputDir"
                input             = "$projectDir/tests/fixtures/samplesheet_variant.csv"
                ref_fasta         = "$projectDir/tests/fixtures/ref.fa"
                vep_cache         = "$projectDir/tests/fixtures/vep_cache"
                vep_species       = "homo_sapiens"
                vep_genome        = "GRCh38"
                vep_cache_version = 110
                tools             = "mhcnuggets"
                min_peptide_length_classI = 9
                max_peptide_length_classI = 10
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert path("${params.outdir}/prep_vcf").exists() },
                { assert path("${params.outdir}/vep").exists() },
                { assert path("${params.outdir}/variant_fasta").exists() },
                { assert path("${params.outdir}/variant_peptides").exists() },
            )
        }
    }
}

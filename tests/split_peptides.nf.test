nextflow_process {

    name "Test Process SPLIT_PEPTIDES"
    script "../modules/local/split_peptides/main.nf"
    process "SPLIT_PEPTIDES"

    tag "pipeline"
    tag "split_peptides"

    test("streams rows into bounded chunks") {

        when {
            params {
                outdir = "$outputDir"
                peptides_split_minchunksize = 2
                peptides_split_maxchunks = 2
            }
            process {
                """
                input[0] = [ [id: 'test'], file("$projectDir/tests/fixtures/peptides.tsv", checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.findAll { key, val -> key.startsWith("versions") }).match("versions")
            def chunks = process.out.splitted.collect { meta, file -> [file.name, file.text] }.sort { it[0] }
            assert chunks == [
                ['test_c0.tsv', 'sequence\nPEP0\nPEP1\nPEP2\n'],
                ['test_c1.tsv', 'sequence\nPEP3\nPEP4\n']
            ]
        }
    }

    test("rejects a non-positive minimum chunk size") {

        when {
            params {
                outdir = "$outputDir"
                peptides_split_minchunksize = 0
                peptides_split_maxchunks = 2
            }
            process {
                """
                input[0] = [ [id: 'invalid'], file("$projectDir/tests/fixtures/peptides.tsv", checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.failed
        }
    }
}

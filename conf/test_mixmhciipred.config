/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/epitopeprediction -profile test_mixmhciipred,docker --outdir <OUTDIR>
 */

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '48.h'
    ]
}

params {
    config_profile_name = 'MixMHCIIpred Test Profile'
    config_profile_description = 'Peptide list based test profile for MixMHCIIpred (Class II)'

    input  = params.pipelines_testdata_base_path + 'epitopeprediction/testdata/sample_sheets/sample_sheet_peptides_class2.csv'
    tools = 'mixmhciipred'
    // Reduce number of possible peptide lengths to speed up test
    min_peptide_length_classII = 12
    max_peptide_length_classII = 21
    wide_format_output = true
}

wave {
    enabled = true
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'GUNZIP_*' {
        publishDir  = [ enabled: false ]
    }

    withName: UNTAR {
        publishDir  = [ enabled: false ]
    }

    withName: BCFTOOLS_STATS {
        publishDir  = [ enabled: false ]
    }

    withName: ADD_GT {
        publishDir = [ enabled: false ]
    }

    withName: BCFTOOLS_VIEW {
        ext.args   = '-f PASS --output-type z'
        ext.prefix = { "${meta.id}.pass" }
        publishDir = [ enabled: false ]
    }

    withName: BCFTOOLS_ANNOTATE {
        ext.args   = '--output-type z'
        ext.prefix = { "${meta.id}.renamed" }
        publishDir = [ enabled: false ]
    }

    withName: BCFTOOLS_NORM {
        ext.args   = '-m- --output-type z'
        ext.prefix = { "${meta.id}.prep" }
        publishDir = [ enabled: false ]
    }

    withName: ENSEMBLVEP_DOWNLOAD {
        // --USE_HTTPS_PROTO needs HTML::TableExtract, which the module's container lacks; without
        // it vep_install lists over FTP, which returns nothing under Docker's default bridge network.
        // Re-check this container pin whenever the module is updated.
        container  = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/1a/1ab876ccbe3e0c93a614e3ecfc2b2166a3699885bb8db67acdb1e8b20a220303/data'
            : 'community.wave.seqera.io/library/ensembl-vep_perl-math-cdf_htslib_gzip_pruned:b8ad5e2045117264' }
        ext.args   = '--AUTO c --CONVERT --NO_BIOPERL --NO_HTSLIB --NO_TEST --NO_UPDATE --USE_HTTPS_PROTO'
        ext.prefix = { "${params.vep_cache_version}_${params.vep_genome}" }
        // Published for reuse via --vep_cache.
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode
        ]
    }

    withName: DOWNLOAD_REF_FASTA {
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode,
            pattern: '*.fa*'
        ]
    }

    withName: ENSEMBLVEP_VEP {
        ext.args = [
            '--vcf',
            '--offline',
            '--symbol',
            '--biotype',
            '--canonical',
            '--mane_select',
            '--tsl',
            '--terms SO',
            '--hgvs',
            '--transcript_version',
            '--uniprot',
            '--numbers',
            '--plugin Wildtype',
            '--plugin Frameshift',
            '--dir_plugins .'
        ].join(' ')
        publishDir = [ enabled: false ]
    }

    withName: PVACSEQ_INSTALL_VEP_PLUGIN {
        publishDir = [ enabled: false ]
    }

    withName: PREP_PROXIMAL_VCF {
        publishDir = [ enabled: false ]
    }

    withName: PVACSEQ_GENERATE_FASTA {
        // -d full keeps the frameshift tail running to the new stop; BCFTOOLS_VIEW already filtered on PASS.
        ext.args   = "-d 'full'"
        publishDir = [ enabled: false ]
    }

    withName: FASTA2PEPTIDES {
        publishDir = [ enabled: false ]
    }

    withName: '.*:GENERATE_VARIANT_PEPTIDES:FASTA2PEPTIDES' {
        publishDir = [
            path: { "${params.outdir}/variant_peptides" },
            mode: params.publish_dir_mode,
            pattern: '*_length_*.tsv'
        ]
    }

    withName: SPLIT_PEPTIDES {
        publishDir = [ enabled: false ]
    }

    withName: PREPARE_PREDICTION_INPUT {
        ext.prefix = {"${meta.file_id}"}
        ext.args   = "--peptide_col_name ${params.peptide_col_name}"
        publishDir = [ enabled: false ]
    }

    withName: MHCFLURRY {
        ext.prefix = {"${meta.file_id}"}
        publishDir = [
            path: { "${params.outdir}/mhcflurry" },
            mode: params.publish_dir_mode,
            pattern: '*.csv'
        ]
    }

    withName: MHCNUGGETS {
        ext.prefix = {"${meta.file_id}"}
        publishDir = [
            path: { "${params.outdir}/mhcnuggets" },
            mode: params.publish_dir_mode,
            pattern: '*predicted_mhcnuggets.csv'
        ]
    }

    withName: NETMHCPAN {
        ext.prefix = {"${meta.file_id}"}
        ext.args = "-BA"
        publishDir = [
            path: { "${params.outdir}/netmhcpan" },
            mode: params.publish_dir_mode,
            pattern: '*.xls'
        ]
    }

    withName: NETMHCIIPAN {
        ext.prefix = {"${meta.file_id}"}
        ext.args = "-BA"
        publishDir = [
            path: { "${params.outdir}/netmhciipan" },
            mode: params.publish_dir_mode,
            pattern: '*.xls'
        ]
    }

    withName: MERGE_PREDICTIONS {
        ext.prefix = {"${meta.file_id}"}
        ext.args   = [
            "--peptide_col_name ${params.peptide_col_name}",
            params.use_ba_rank ? "--use_ba_rank" : ""
        ].join(' ').trim()
        publishDir = [ enabled: false ]
    }

    withName: SUMMARIZE_RESULTS {
        ext.args = [
            params.wide_format_output ? "--wide_format_output" : "",
            params.binder_only ? "--binder_only" : ""
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/predictions" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'GUNZIP_*' {
        publishDir  = [ enabled: false ]
    }

    withName: BCFTOOLS_STATS {
        publishDir  = [ enabled: false ]
    }

    withName: PREP_VCF {
        ext.prefix = {"${meta.id}"}
        publishDir = [
            path: { "${params.outdir}/prep_vcf" },
            mode: params.publish_dir_mode,
            pattern: '*.prep.vcf.gz*'
        ]
    }

    withName: ENSEMBLVEP_DOWNLOAD {
        // --AUTO c: cache only (the reference FASTA is fetched separately by DOWNLOAD_REF_FASTA,
        // since vep_install's --AUTO f step is unreliable). --NO_* keeps vep_install non-interactive.
        // Published for reuse via --vep_cache.
        ext.args   = '--AUTO c --NO_BIOPERL --NO_HTSLIB --NO_TEST --NO_UPDATE'
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode
        ]
    }

    withName: DOWNLOAD_REF_FASTA {
        publishDir = [
            path: { "${params.outdir}/references" },
            mode: params.publish_dir_mode,
            pattern: '*.fa*'
        ]
    }

    withName: ENSEMBLVEP_VEP {
        // Offline Ensembl cache (ENST transcripts only) + the pVACtools Wildtype/Frameshift plugins
        // (staged via the module's extra_files input). The module already supplies
        // --cache/--cache_version/--dir_cache/--assembly/--species/--fasta/--fork/--compress_output.
        ext.args = [
            '--vcf',
            '--offline',
            '--symbol',
            '--biotype',
            '--canonical',
            '--mane_select',
            '--tsl',
            '--terms SO',
            '--hgvs',
            '--transcript_version',
            '--uniprot',
            '--numbers',
            '--plugin Wildtype',
            '--plugin Frameshift',
            '--dir_plugins .'
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/vep" },
            mode: params.publish_dir_mode,
            pattern: '*.vcf.gz'
        ]
    }

    withName: PVACSEQ_GENERATE_FASTA {
        publishDir = [
            path: { "${params.outdir}/variant_fasta" },
            mode: params.publish_dir_mode,
            pattern: '*.variant_peptides.raw.fasta'
        ]
    }

    withName: VARIANT_FASTA2PEPTIDES {
        publishDir = [
            path: { "${params.outdir}/variant_peptides" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: FASTA2PEPTIDES {
        publishDir = [ enabled: false ]
    }

    withName: SPLIT_PEPTIDES {
        publishDir = [ enabled: false ]
    }

    withName: PREPARE_PREDICTION_INPUT {
        ext.prefix = {"${meta.file_id}"}
        ext.args   = "--peptide_col_name ${params.peptide_col_name}"
        publishDir = [ enabled: false ]
    }

    withName: MHCFLURRY {
        ext.prefix = {"${meta.file_id}"}
        publishDir = [
            path: { "${params.outdir}/mhcflurry" },
            mode: params.publish_dir_mode,
            pattern: '*.csv'
        ]
    }

    withName: MHCNUGGETS {
        ext.prefix = {"${meta.file_id}"}
        publishDir = [
            path: { "${params.outdir}/mhcnuggets" },
            mode: params.publish_dir_mode,
            pattern: '*predicted_mhcnuggets.csv'
        ]
    }

    withName: NETMHCPAN {
        ext.prefix = {"${meta.file_id}"}
        ext.args = "-BA"
        publishDir = [
            path: { "${params.outdir}/netmhcpan" },
            mode: params.publish_dir_mode,
            pattern: '*.xls'
        ]
    }

    withName: NETMHCIIPAN {
        ext.prefix = {"${meta.file_id}"}
        ext.args = "-BA"
        publishDir = [
            path: { "${params.outdir}/netmhciipan" },
            mode: params.publish_dir_mode,
            pattern: '*.xls'
        ]
    }

    withName: MERGE_PREDICTIONS {
        ext.prefix = {"${meta.file_id}"}
        ext.args   = [
            "--peptide_col_name ${params.peptide_col_name}",
            params.use_ba_rank ? "--use_ba_rank" : ""
        ].join(' ').trim()
        publishDir = [ enabled: false ]
    }

    withName: SUMMARIZE_RESULTS {
        ext.args = [
            params.wide_format_output ? "--wide_format_output" : "",
            params.binder_only ? "--binder_only" : ""
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/predictions" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

/*
 * -------------------------------------------------
 *  Nextflow config file for running MixMHCpred tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/epitopeprediction -profile test_mixmhcpred,docker --outdir <OUTDIR>
 *   nf-test test tests/mixmhcpred.nf.test --profile=+docker
 *
 * Note: Wave is enabled in this config for on-the-fly container building (license restriction).
 * MixMHCpred is free for academic use only; commercial use requires a separate
 * license from the Ludwig Institute for Cancer Research.
 */

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '48.h'
    ]
}

params {
    config_profile_name = 'MixMHCpred Test Profile'
    config_profile_description = 'Peptide list based test profile for MixMHCpred'

    input  = params.pipelines_testdata_base_path + 'epitopeprediction/testdata/sample_sheets/sample_sheet_peptides.csv'
    tools = 'mixmhcpred'
    // Reduce number of possible peptide lengths to speed up test
    min_peptide_length_classI = 9
    max_peptide_length_classI = 10
    // Covers the wide-format summary path, which resolves the best allele per predictor
    wide_format_output = true
}

// Enable Wave for on-the-fly container building (required for MixMHCpred due to license)
wave {
    enabled = true
}
